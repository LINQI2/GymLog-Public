page {
  --bg: #f1f3f7;
  --surface: #ffffff;
  --surface-2: #f4f6f9;
  --line: #e2e6ec;
  --line-strong: #cfd6df;
  --ink: #12161f;
  --muted: #6b7482;
  --accent: #0f9d6e;
  --accent-soft: rgba(15, 157, 110, 0.1);
  --accent-ink: #ffffff;
  --danger: #d64545;
  --warn: #b7791f;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica,
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  /* 自定义 tabBar(112rpx) + 休息计时条 + 安全区 */
  padding: 20rpx 24rpx calc(300rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(18, 22, 31, 0.04);
}

/* ---------- 线性图标 ----------
   路径直接搬自安卓版 src/components/Icons.tsx，用 SVG data URI 渲染。
   小程序 WXML 不支持 <svg> 标签，WXSS 背景图可以。 */
.ic {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.ic.lg {
