/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 92rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0 24rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  color: var(--accent-ink);
  box-shadow: 0 6rpx 18rpx rgba(15, 157, 110, 0.22);
}

.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
}

.btn-danger-ghost {
  background: var(--surface);
  color: var(--danger);
  border: 1rpx solid var(--line);
}

.btn-sm {
  height: 64rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.btn[disabled] {
  opacity: 0.5;
}

.btn-hover {
  opacity: 0.82;
}

/* ---------- 输入 ---------- */
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
}

/* ---------- 标签 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--muted);
  font-size: 24rpx;
}

.chip-active {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1rpx dashed var(--line-strong);
  border-radius: 24rpx;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

/* 通用布局 */
.row {
  display: flex;
  align-items: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gap-8 {
  gap: 8rpx;
}

.gap-12 {
  gap: 12rpx;
}

.gap-16 {
  gap: 16rpx;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-12 {
  margin-top: 12rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}
