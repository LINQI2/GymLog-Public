.wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary {
  display: flex;
  gap: 12rpx;
}

.summary-item {
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f4f6f9;
}

.label {
  display: block;
  font-size: 20rpx;
  color: #9aa4b2;
}

.value {
  display: block;
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #12161f;
}

.value.small {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
}

.empty-tip {
  padding: 30rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #9aa4b2;
}

.rows {
  border-top: 1rpx solid #eef1f5;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #f4f6f9;
  font-size: 20rpx;
  font-weight: 700;
  color: #6b7482;
  flex-shrink: 0;
}

.index.warm {
  background: rgba(183, 121, 31, 0.14);
  color: #b7791f;
}

.weight {
  font-size: 27rpx;
  font-weight: 600;
  color: #12161f;
}

.times {
  font-size: 23rpx;
  color: #6b7482;
}

.right {
  margin-left: auto;
  text-align: right;
}

.time {
  display: block;
  font-size: 22rpx;
  color: #6b7482;
}

.gap {
  display: block;
  font-size: 19rpx;
  color: #9aa4b2;
}

.tip {
  font-size: 20rpx;
  line-height: 1.6;
  color: #9aa4b2;
}
