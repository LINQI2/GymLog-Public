<view wx:if="{{show}}" class="mask" bindtap="onMaskTap" catchtouchmove="noop">
  <view class="panel" catchtap="noop">
    <view class="head">
      <text class="title">{{title}}</text>
      <view class="close" bindtap="onClose" hover-class="close-hover">关闭</view>
    </view>
    <scroll-view scroll-y class="body" enhanced show-scrollbar="{{false}}">
      <slot></slot>
    </scroll-view>
    <view class="safe-bottom"></view>
  </view>
</view>
