<view class="bar">
  <view
    class="item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="item-hover"
  >
    <view class="ic ic-{{item.icon}}"></view>
    <text class="label">{{item.text}}</text>
  </view>
</view>
