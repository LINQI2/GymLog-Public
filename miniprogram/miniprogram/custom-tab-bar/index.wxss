.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 低于页面弹层(100)与休息计时条(90)，避免盖住遮罩 */
  z-index: 50;
  display: flex;
  align-items: stretch;
  height: calc(116rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e2e6ec;
  box-shadow: 0 -4rpx 24rpx rgba(18, 22, 31, 0.06);
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6b7482;
}

.item-hover {
  opacity: 0.7;
}

.item.on {
  color: #0f9d6e;
}

.item .ic {
  width: 48rpx;
  height: 48rpx;
}

.label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}

.item.on .label {
  font-weight: 700;
}
