<view class="page">
  <view class="head card" wx:if="{{list.length}}">
    <text class="head-num">{{list.length}}</text>
    <text class="head-label">天有训练记录</text>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <text class="empty-title">还没有历史记录</text>
    <text class="empty-desc">去「今日」记录第一组训练，这里会按日期自动汇总。</text>
  </view>

  <view wx:else class="list">
    <view
      class="item card"
      wx:for="{{list}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="onOpen"
      hover-class="item-hover"
    >
      <view class="item-top">
        <view class="item-title-wrap">
          <text class="item-date">{{item.label}}</text>
          <text class="item-relative" wx:if="{{item.relative}}">{{item.relative}}</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <text class="item-summary">{{item.summary}}</text>
      <view class="item-stats">
        <text>{{item.exerciseCount}} 个动作</text>
        <text class="dot">·</text>
        <text>{{item.setCount}} 组</text>
        <text class="dot">·</text>
        <text>{{item.volumeText}}</text>
      </view>
    </view>
  </view>
</view>

<rest-bar above-tab-bar="{{true}}" />
