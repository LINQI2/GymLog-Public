.page {
  padding-bottom: 240rpx;
}

.head {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #12161f;
}

.target {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #0f9d6e;
}

.desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #6b7482;
}

.meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #6b7482;
}

.badge {
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(15, 157, 110, 0.1);
  color: #0f9d6e;
  font-size: 19rpx;
}

.ops {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.op {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 16rpx;
  border: 1rpx solid #e2e6ec;
  background: #ffffff;
  font-size: 23rpx;
  color: #6b7482;
}

.op-active {
  border-color: #b7791f;
  background: rgba(183, 121, 31, 0.08);
  color: #b7791f;
}

.op-danger {
  color: #d64545;
}

.list-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.list-title {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7482;
}

.link {
  font-size: 23rpx;
  color: #0f9d6e;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.item {
  padding: 22rpx;
}

.item-on {
  border-color: #0f9d6e;
  background: rgba(15, 157, 110, 0.05);
}

.item-hover {
  opacity: 0.85;
}

.item-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.check {
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 10rpx;
  border: 1rpx solid #cfd6df;
  background: #ffffff;
  color: #ffffff;
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.check-on {
  background: #0f9d6e;
  border-color: #0f9d6e;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #12161f;
}

.sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7482;
}

.note {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9aa4b2;
}

.edit {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eef1f5;
}

.edit-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.label {
  font-size: 21rpx;
  color: #6b7482;
}

.mini {
  width: 78rpx;
  height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 12rpx;
  background: #ffffff;
}

.dash {
  color: #9aa4b2;
}

.edit-ops {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.mini-btn {
  flex: 1;
  padding: 12rpx 0;
  text-align: center;
  border-radius: 12rpx;
  background: #f4f6f9;
  font-size: 21rpx;
  color: #6b7482;
}

.mini-btn.danger {
  color: #d64545;
}

.add-row {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx dashed #cfd6df;
  border-radius: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6b7482;
}

.tips {
  margin-top: 20rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #9aa4b2;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(241, 243, 247, 0.97);
}
